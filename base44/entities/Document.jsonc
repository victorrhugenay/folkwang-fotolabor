{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titel"
    },
    "description": {
      "type": "string",
      "title": "Beschreibung"
    },
    "file_url": {
      "type": "string",
      "title": "Datei-URL"
    },
    "folder": {
      "type": "string",
      "title": "Ordner"
    },
    "target": {
      "type": "string",
      "title": "Zielgruppe",
      "enum": [
        "all",
        "user"
      ],
      "enumNames": [
        "Alle Nutzer",
        "Einzelner Nutzer"
      ]
    },
    "user_email": {
      "type": "string",
      "title": "Nutzer-E-Mail (bei Einzelzuweisung)"
    }
  },
  "required": [
    "title",
    "file_url",
    "target"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.target": "all"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
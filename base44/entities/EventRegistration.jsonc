{
  "name": "EventRegistration",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "title": "Veranstaltungs-ID"
    },
    "event_title": {
      "type": "string",
      "title": "Veranstaltung"
    },
    "user_email": {
      "type": "string",
      "title": "E-Mail"
    },
    "user_name": {
      "type": "string",
      "title": "Name"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "registered",
        "invited",
        "cancelled"
      ],
      "enumNames": [
        "Angemeldet",
        "Eingeladen",
        "Abgesagt"
      ]
    }
  },
  "required": [
    "event_id",
    "user_email",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dozent"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dozent"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dozent"
          }
        }
      ]
    }
  }
}
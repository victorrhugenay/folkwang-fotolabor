{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titel"
    },
    "description": {
      "type": "string",
      "title": "Beschreibung"
    },
    "type": {
      "type": "string",
      "title": "Typ",
      "enum": [
        "course",
        "event"
      ],
      "enumNames": [
        "Kurs",
        "Einzelveranstaltung"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Startdatum"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "Enddatum"
    },
    "start_time": {
      "type": "string",
      "title": "Startzeit"
    },
    "end_time": {
      "type": "string",
      "title": "Endzeit"
    },
    "location": {
      "type": "string",
      "title": "Ort / Raum"
    },
    "capacity": {
      "type": "number",
      "title": "Max. Teilnehmerzahl"
    },
    "image_url": {
      "type": "string",
      "title": "Bild-URL"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "upcoming",
        "cancelled",
        "completed"
      ],
      "enumNames": [
        "Geplant",
        "Abgesagt",
        "Abgeschlossen"
      ]
    },
    "group_ids": {
      "type": "array",
      "title": "Freigeschaltete Gruppen",
      "items": {
        "type": "string"
      }
    },
    "is_recurring": {
      "type": "boolean",
      "title": "Wiederkehrend"
    },
    "recurrence_type": {
      "type": "string",
      "title": "Wiederholungsmuster",
      "enum": [
        "daily",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "enumNames": [
        "T\u00e4glich",
        "W\u00f6chentlich",
        "Alle 2 Wochen",
        "Monatlich"
      ]
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "title": "Wiederholung bis"
    },
    "recurring_days": {
      "type": "array",
      "title": "Wiederholungstage (Mo=1, So=7)",
      "items": {
        "type": "integer"
      }
    }
  },
  "required": [
    "title",
    "start_date",
    "end_date",
    "start_time",
    "end_time",
    "status"
  ]
}
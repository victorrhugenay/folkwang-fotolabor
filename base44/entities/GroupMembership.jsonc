{
  "name": "GroupMembership",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "title": "Gruppen-ID"
    },
    "group_name": {
      "type": "string",
      "title": "Gruppenname"
    },
    "user_email": {
      "type": "string",
      "title": "E-Mail des Nutzers"
    },
    "user_name": {
      "type": "string",
      "title": "Name des Nutzers"
    }
  },
  "required": [
    "group_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
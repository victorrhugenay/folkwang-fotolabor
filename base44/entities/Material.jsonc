{
  "name": "Material",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Beschreibung"
    },
    "image_url": {
      "type": "string",
      "title": "Bild-URL"
    },
    "unit": {
      "type": "string",
      "title": "Einheit",
      "enum": [
        "St\u00fcck",
        "kg",
        "Liter",
        "Meter",
        "m\u00b2",
        "Paket",
        "Stunde"
      ],
      "enumNames": [
        "St\u00fcck",
        "kg",
        "Liter",
        "Meter",
        "m\u00b2",
        "Paket",
        "Stunde"
      ]
    },
    "price_per_unit": {
      "type": "number",
      "title": "Preis pro Einheit (\u20ac)"
    },
    "current_stock": {
      "type": "number",
      "title": "Aktueller Bestand"
    },
    "category": {
      "type": "string",
      "title": "Kategorie",
      "enum": [
        "Verbrauchsmaterial",
        "Werkzeug",
        "Schutzausr\u00fcstung",
        "Reinigung",
        "Sonstiges"
      ],
      "enumNames": [
        "Verbrauchsmaterial",
        "Werkzeug",
        "Schutzausr\u00fcstung",
        "Reinigung",
        "Sonstiges"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "available",
        "low_stock",
        "out_of_stock"
      ],
      "enumNames": [
        "Verf\u00fcgbar",
        "Wenig Bestand",
        "Nicht verf\u00fcgbar"
      ]
    }
  },
  "required": [
    "name",
    "unit",
    "price_per_unit"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}